{
  "name": "@ib/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative game server: rooms, players and real-time lobby over Socket.IO.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15"
  }
}
