# Game server settings. All are optional; these are the defaults.
# Copy to .env and edit, or set them in your shell / hosting dashboard.

# Port and interface the game server listens on.
PORT=3001
HOST=0.0.0.0

# Seconds a disconnected player keeps their seat before being removed.
RECONNECT_GRACE_SECONDS=60

# Safety limits.
MAX_ROOMS=2000
# Rooms one IP address may create in a burst (refills one every 6 seconds).
ROOM_CREATE_BURST=10

# Set to true when running behind a reverse proxy (nginx, Caddy, Cloudflare...)
# so rate limits use the real client IP from X-Forwarded-For.
TRUST_PROXY=false

# Only needed if the website is hosted on a different origin than this server.
# Comma-separated list, e.g. https://play.example.com
CLIENT_ORIGIN=

# ---- Voice chat (LiveKit) ----
# Leave all three empty in development: `npm run dev` starts a local LiveKit with its
# built-in dev keys and the browser reaches it at /livekit through the dev server.
# In production set all three. The secret stays on this server; browsers only get
# short-lived, room-scoped, microphone-only tokens.
#
# URL browsers connect to: wss://voice.example.com (or a path such as /livekit when a
# proxy on the same site forwards it to LiveKit).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Only needed when LIVEKIT_URL is a path, or when this server should reach LiveKit at a
# different (internal) address, e.g. http://localhost:7880
LIVEKIT_API_URL=
# Set LIVEKIT_URL=off to run without voice chat.

# ---- Development only ----
# Where Vite forwards /socket.io and /api, and /livekit.
GAME_SERVER_URL=http://localhost:3001
LIVEKIT_DEV_URL=http://localhost:7880
# Interface the local LiveKit listens on (npm run dev). 127.0.0.1 is enough because the
# browser reaches it through the Vite dev server; audio uses the LAN address automatically.
VOICE_BIND=127.0.0.1
