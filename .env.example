# Game server settings. All are optional; these are the defaults.
# Copy to .env and edit, or set them in your shell / hosting dashboard.

# Port and interface the game server listens on.
PORT=3001
HOST=0.0.0.0

# Seconds a disconnected player keeps their seat before being removed.
RECONNECT_GRACE_SECONDS=60

# Safety limits.
MAX_ROOMS=2000
# Rooms one IP address may create in a burst (refills one every 6 seconds).
ROOM_CREATE_BURST=10

# Set to true when running behind a reverse proxy (nginx, Caddy, Cloudflare...)
# so rate limits use the real client IP from X-Forwarded-For.
TRUST_PROXY=false

# Only needed if the website is hosted on a different origin than this server.
# Comma-separated list, e.g. https://play.example.com
CLIENT_ORIGIN=

# Development only: where Vite forwards /socket.io and /api.
GAME_SERVER_URL=http://localhost:3001
